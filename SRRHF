def parse_input(path: str) -> None:
    try:
        with open(path, encoding='utf-8', errors='ignore') as f: txt = f.read()
    except FileNotFoundError: print(f"Error: {path} not found."); sys.exit(1)

    lines = txt.splitlines()
    if not lines: return
    Run.NAME = lines[0].strip()
    Run.LINES = []; Run.VARY = []
    P.SPINS = []
    
    idx = 0; trans_start = -1
    while idx < len(lines):
        raw = lines[idx].strip()
        if raw.upper().startswith('TRANSITIONS') or raw.upper().startswith('TRANSI'): 
            trans_start = idx; break
        
        parts = raw.split()
        if len(parts) >= 2:
            key = parts[0].upper()
            if key in ['TEMP','MUA','MUB','MUC','FMIN','FMAX','JMIN','JMAX','ITER','REDUCTION','REP']:
                try:
                    if key in ['JMIN','JMAX','ITER']: val = int(float(parts[1]))
                    elif key in ['REDUCTION','REP']: val = parts[1]
                    else: val = float(parts[1])
                    if key == 'ITER': Run.NCY = val
                    elif key == 'REDUCTION': P.REDUCTION = val.upper()
                    elif key == 'REP': P.REP = val
                    else: setattr(P, key, val)
                except: pass
            elif key == 'SPIN':
                for x in parts[1:]: P.SPINS.append(float(x))
            elif key in ['A','B','C','DJ','DJK','DK','DELTAJ','DELTAK','D1','D2','XAA','XBB-XCC','XBB_XCC','XAB','XAC','XBC']:
                attr = key
                if key == 'DELTAJ': attr = 'dJ'
                if key == 'DELTAK': attr = 'dK'
                if key == 'D1': attr = 'd1'
                if key == 'D2': attr = 'd2'
                if key in ['XBB-XCC','XBB_XCC']: attr = 'Xbb_Xcc'
                if key == 'XAA': attr = 'Xaa'
                if key == 'XAB': attr = 'Xab'
                if key == 'XAC': attr = 'Xac'
                if key == 'XBC': attr = 'Xbc'
                try:
                    val = float(parts[1])
                    flag = 0
                    if len(parts) > 2: flag = int(float(parts[2]))
                    if hasattr(P, attr): setattr(P, attr, val)
                    Run.VARY.append((attr, val, flag))
                except: pass
        idx += 1
        
    Run.INIT_A = P.A
    Run.INIT_B = P.B
    Run.INIT_C = P.C
        
    if trans_start != -1:
        has_spin = (len(P.SPINS) > 0 and sum(P.SPINS) > 1e-5)
        for line in lines[trans_start+1:]:
            p = line.split()
            if len(p) < 8: continue
            try:
                if len(p) >= 10:
                    if has_spin:
                        l = Line(int(p[0]), int(p[1]), int(p[2]), 
                                 int(p[4]), int(p[5]), int(p[6]),
                                 float(p[8]), 1.0, float(p[9]),
                                 F1=float(p[3]), F2=float(p[7]))
                    else:
                        l = Line(int(p[0]), int(p[1]), int(p[2]), 
                                 int(p[4]), int(p[5]), int(p[6]),
                                 float(p[8]), 1.0, float(p[9]))
                else:
                    l = Line(int(p[0]), int(p[1]), int(p[2]), 
                             int(p[3]), int(p[4]), int(p[5]),
                             float(p[6]), 1.0, float(p[7]))
                
                if l.error > 1e-9: l.weight = 1.0/(l.error**2)
                else: l.weight = 0.0
                Run.LINES.append(l)
            except: continue

