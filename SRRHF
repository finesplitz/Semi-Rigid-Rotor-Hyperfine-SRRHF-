# 4. Total Matrix Hamiltonian Generation                             #
# ------------------------------------------------------------------ #
def build_matrices(J):
    dim = 2*J + 1
    K_vals = np.arange(-J, J+1)
    Jz = np.diag(K_vals)
    Jp = np.zeros((dim, dim))
    Jm = np.zeros((dim, dim))
    for i, K in enumerate(K_vals):
        if i+1 < dim: Jp[i+1, i] = math.sqrt((J - K)*(J + K + 1))
        if i-1 >= 0: Jm[i-1, i] = math.sqrt((J + K)*(J - K + 1))
    Jx = 0.5 * (Jp + Jm)
    Jy = -0.5j * (Jp - Jm)
    return Jx, Jy, Jz, K_vals

def build_rot_hamiltonian(J):
    Jx, Jy, Jz, K_vals = build_matrices(J)
    
    if P.REP == 'IIIr': Ja, Jb, Jc = Jx, Jy, Jz 
    else: Ja, Jb, Jc = Jz, Jx, Jy 
    
    Ja2 = Ja @ Ja; Jb2 = Jb @ Jb; Jc2 = Jc @ Jc
    J2  = Ja2 + Jb2 + Jc2 
    
    H = P.A * Ja2 + P.B * Jb2 + P.C * Jc2
    
    if P.REDUCTION == 'A':
        H += -P.DJ * (J2 @ J2) - P.DJK * (J2 @ Jz @ Jz) - P.DK * (Jz @ Jz @ Jz @ Jz)
        if abs(P.dJ) > 1e-20: H += -2.0 * P.dJ * (J2 @ (Jx @ Jx - Jy @ Jy))
        if abs(P.dK) > 1e-20: 
            diff2 = Jx @ Jx - Jy @ Jy
            H += -P.dK * (Jz @ Jz @ diff2 + diff2 @ Jz @ Jz)
    elif P.REDUCTION == 'S':
        H += -P.DJ * (J2 @ J2) - P.DJK * (J2 @ Jz @ Jz) - P.DK * (Jz @ Jz @ Jz @ Jz)
        if abs(P.d1) > 1e-20 or abs(P.d2) > 1e-20:
            Jp = Jx + 1j * Jy; Jm = Jx - 1j * Jy
            Jp2 = Jp @ Jp; Jm2 = Jm @ Jm
            if abs(P.d1) > 1e-20: H += P.d1 * (J2 @ (Jp2 + Jm2))
            if abs(P.d2) > 1e-20: H += P.d2 * (Jp2 @ Jp2 + Jm2 @ Jm2)
            
    return H, K_vals

def build_quadrupole_block(j1, j2, I, F):
    dim1 = 2*j1 + 1
    dim2 = 2*j2 + 1
    HQ = np.zeros((dim1, dim2), dtype=complex)
    if I < 1e-9: return HQ
    
    sixj = wigner6j(F, I, j1, 2.0, j2, I)
    if abs(sixj) < 1e-12: return HQ
    
    I3 = math.sqrt(I*(2*I - 1) / ((I + 1)*(2*I + 1)*(2*I + 3)))
    if I3 < 1e-12: return HQ
    
    sign_F = 1 if int(round(I + j1 + F)) % 2 == 0 else -1
    F_factor = sign_F * sixj / I3
    
    Xaa = P.Xaa
    Xbb = -0.5*P.Xaa + 0.5*P.Xbb_Xcc
    Xcc = -0.5*P.Xaa - 0.5*P.Xbb_Xcc
    
    if P.REP == 'IIIr':
        chi_zz = Xcc; chi_xx = Xaa; chi_yy = Xbb
        chi_xz = P.Xac; chi_yz = P.Xbc; chi_xy = P.Xab
    else:
        chi_zz = Xaa; chi_xx = Xbb; chi_yy = Xcc
        chi_xz = P.Xab; chi_yz = P.Xac; chi_xy = P.Xbc
        
    T0 = 0.5 * chi_zz
    T1_pos = - (chi_xz + 1j * chi_yz) / math.sqrt(6.0)
    T1_neg =   (chi_xz - 1j * chi_yz) / math.sqrt(6.0)
    T2_pos =   (chi_xx - chi_yy + 2j * chi_xy) / math.sqrt(24.0)
    T2_neg =   (chi_xx - chi_yy - 2j * chi_xy) / math.sqrt(24.0)
    
    T_dict = {0: T0, 1: T1_pos, -1: T1_neg, 2: T2_pos, -2: T2_neg}
    
    sqrt_j1_j2 = math.sqrt((2*j2 + 1)*(2*j1 + 1))
    
    for idx1, k1 in enumerate(range(-j1, j1+1)):
        for idx2, k2 in enumerate(range(-j2, j2+1)):
            q = k1 - k2
            if abs(q) > 2: continue
            
            tj = wigner3j(j1, 2.0, j2, -k1, q, k2)
            if abs(tj) < 1e-12: continue
            
            sign_K = 1 if int(round(j1 - k1)) % 2 == 0 else -1
            M_part = 0.5 * sqrt_j1_j2 * sign_K * tj * T_dict[q]
            HQ[idx1, idx2] = F_factor * M_part
            
    return HQ

def solve_energy_levels(Jmax):
    has_spin = (len(P.SPINS) > 0 and sum(P.SPINS) > 1e-5)
    I = P.SPINS[0] if has_spin else 0.0
    
    rot_levels = {}
    for J in range(Jmax + 3):
        H_rot, K_vals = build_rot_hamiltonian(J)
        w, v = np.linalg.eigh(H_rot)
        pairs = []
        for ka in range(J + 1):
             for kc in range(J + 1):
                 if (ka + kc == J) or (ka + kc == J + 1): pairs.append((ka, kc))
        pairs.sort(key=lambda x: (x[0], -x[1]))
        rot_levels[J] = []
        for i in range(len(w)):
            rot_levels[J].append({'J':J, 'E': w[i], 'vec': v[:, i], 'Ka': pairs[i][0], 'Kc': pairs[i][1], 'hfs': [], 'K_vals': K_vals})

    f_vals = set()
    for J in range(Jmax + 1):
        if has_spin:
            for f in np.arange(abs(J-I), J+I+1.0): f_vals.add(f)
        else:
            f_vals.add(float(J))
            
    for F in sorted(list(f_vals)):
        if has_spin:
            valid_J = [j for j in range(Jmax + 3) if abs(F-I) <= j <= F+I]
        else:
            valid_J = [int(F)]
            
        dim = sum(2*j + 1 for j in valid_J)
        H_tot = np.zeros((dim, dim), dtype=complex)
        
        idx_offset = 0
        basis_map = [] 
        j_offsets = {}
        
        for j in valid_J:
            H_rot, K_vals = build_rot_hamiltonian(j)
            size = 2*j + 1
            H_tot[idx_offset:idx_offset+size, idx_offset:idx_offset+size] = H_rot
            j_offsets[j] = idx_offset
            for k in K_vals: basis_map.append((j, k))
            idx_offset += size
            
        if has_spin and I > 1e-9:
            for i_j1, j1 in enumerate(valid_J):
                for i_j2, j2 in enumerate(valid_J):
                    if j1 > j2: continue 
                    
                    HQ_block = build_quadrupole_block(j1, j2, I, F)
                    off1, s1 = j_offsets[j1], 2*j1 + 1
                    off2, s2 = j_offsets[j2], 2*j2 + 1
                    
                    H_tot[off1:off1+s1, off2:off2+s2] += HQ_block
                    if j1 != j2: 
                        H_tot[off2:off2+s2, off1:off1+s1] += HQ_block.conj().T
        
        w, v = np.linalg.eigh(H_tot)
        
        for i in range(len(w)):
            eig_val = w[i]
            eig_vec = v[:, i]
            
            dom_idx = np.argmax(np.abs(eig_vec))
            dom_J, _ = basis_map[dom_idx]
            
            if dom_J > Jmax: continue 
            
            j_start = j_offsets[dom_J]
            vec_J = eig_vec[j_start:j_start + (2*dom_J + 1)]
            
            best_ov = -1.0; match_idx = 0
            if dom_J > 0 and len(rot_levels[dom_J]) > 0:
                for ri, rstate in enumerate(rot_levels[dom_J]):
                    ov = abs(np.vdot(rstate['vec'], vec_J))
                    if ov > best_ov: best_ov=ov; match_idx=ri
            
            rot_levels[dom_J][match_idx]['hfs'].append({
                'F': F, 'E': eig_val, 'vec': vec_J, 'K_vals': np.arange(-dom_J, dom_J+1)
            })
            
    return {J: rot_levels[J] for J in range(Jmax + 1)}

def calc_matrix_intensity(u_hfs, l_hfs, Ju, Jl, I):
    if abs(u_hfs['F'] - l_hfs['F']) > 1.1: return 0.0
    
    Vu = u_hfs['vec']; Vl = l_hfs['vec']
    Ku = u_hfs['K_vals']; Kl = l_hfs['K_vals']
    
    dim_u = len(Vu); dim_l = len(Vl)
    Phi_Z = np.zeros((dim_u, dim_l))
    Phi_X = np.zeros((dim_u, dim_l))
    Phi_Y = np.zeros((dim_u, dim_l), dtype=complex)
    
    for iu, k_u in enumerate(Ku):
        for il, k_l in enumerate(Kl):
            dk = k_u - k_l
            if abs(dk) < 0.1: 
                val = 0.0
                if Ju == Jl: val = k_u/math.sqrt(Ju*(Ju+1)) if Ju>0 else 0
                elif Ju == Jl+1: val = math.sqrt(Ju**2 - k_u**2)/math.sqrt(Ju*(2*Ju+1))
                elif Jl == Ju+1: val = math.sqrt(Jl**2 - k_l**2)/math.sqrt(Jl*(2*Jl+1))
                Phi_Z[iu, il] = val
            elif abs(abs(dk)-1.0) < 0.1: 
                val = 0.0; sign = -1.0 if dk > 0 else 1.0
                if Ju == Jl:
                    t = (Jl - k_l*dk)*(Jl + k_l*dk + 1)
                    if t>0: val = math.sqrt(t)/(2*math.sqrt(Jl*(Jl+1)))
                elif Ju == Jl+1:
                    t = (Jl + k_l*dk + 1)*(Jl + k_l*dk + 2)
                    if t>0: val = sign * math.sqrt(t)/(2*math.sqrt(Ju*(2*Ju+1)))
                if val != 0.0:
                    Phi_X[iu, il] += val
                    Phi_Y[iu, il] += 1j * sign * val

    if P.REP == 'IIIr': Da=Phi_X; Db=Phi_Y; Dc=Phi_Z
    else: Da=Phi_Z; Db=Phi_X; Dc=Phi_Y
    
    S = 0.0
    if abs(P.MUA) > 1e-9: S += abs(np.vdot(Vu, Da @ Vl))**2 * P.MUA**2
    if abs(P.MUB) > 1e-9: S += abs(np.vdot(Vu, Db @ Vl))**2 * P.MUB**2
    if abs(P.MUC) > 1e-9: S += abs(np.vdot(Vu, Dc @ Vl))**2 * P.MUC**2
    
    sixj = wigner6j(Ju, u_hfs['F'], I, l_hfs['F'], Jl, 1.0)
    geom = (2*u_hfs['F']+1)*(2*l_hfs['F']+1) * sixj**2
    return S * geom

# ------------------------------------------------------------------ #
# 5. Fit Routine                                                     #
# ------------------------------------------------------------------ #
def run_fit(vary_list):
    print(f"--- Matrix Fit (Numerical Differentiation) ---")
    p_vec = np.array([getattr(P, p) for p in vary_list])
    
    def get_residuals(curr_params):
        for p, val in zip(vary_list, curr_params): setattr(P, p, val)
        needed_J = 0
        for ln in Run.LINES: needed_J = max(needed_J, ln.N1, ln.N2)
        levels = solve_energy_levels(needed_J)
        resids = []
        for ln in Run.LINES:
            u_parent = next((s for s in levels[ln.N1] if s['Ka']==ln.K1 and s['Kc']==ln.Kp1), None)
            l_parent = next((s for s in levels[ln.N2] if s['Ka']==ln.K2 and s['Kc']==ln.Kp2), None)
            calc = 0.0
            if u_parent and l_parent:
                if ln.F1 is not None:
                    u_hfs = next((s for s in u_parent['hfs'] if abs(s['F']-ln.F1)<0.1), None)
                    l_hfs = next((s for s in l_parent['hfs'] if abs(s['F']-ln.F2)<0.1), None)
                    if u_hfs and l_hfs: calc = u_hfs['E'] - l_hfs['E']
                else:
                    calc = u_parent['E'] - l_parent['E']
            resids.append(ln.freq - calc)
            ln.calc = calc; ln.res = ln.freq - calc
        return np.array(resids)

    for it in range(max(1, Run.NCY)):
        print(f"Iter {it+1}...")
        r0 = get_residuals(p_vec)
        jac = []
        step = 1e-5
        for i, p_name in enumerate(vary_list):
            p_save = p_vec[i]
            p_vec[i] += step
            r_plus = get_residuals(p_vec)
            p_vec[i] = p_save
            deriv = (r0 - r_plus) / step
            jac.append(deriv)
        Jac = np.array(jac).T
        W = np.diag([ln.weight for ln in Run.LINES])
        JtW = Jac.T @ W
        Alpha = JtW @ Jac + np.eye(len(p_vec))*(1e-3 if it<2 else 0.0)
        Beta = JtW @ r0
        try: delta_p = np.linalg.solve(Alpha, Beta)
        except: delta_p = np.linalg.pinv(Alpha) @ Beta
        p_vec += delta_p
        if np.max(np.abs(delta_p)) < 1e-7: break

    r_fin = get_residuals(p_vec)
    RSS = np.sum([ln.weight * ln.res**2 for ln in Run.LINES])
    dof = max(1, len(Run.LINES) - len(p_vec))
    rms_fit = np.sqrt(RSS/len(Run.LINES))
    raw_rms = np.sqrt(np.mean(r_fin**2))
    Cov = np.linalg.pinv(Jac.T @ W @ Jac) * (RSS/dof)
    diag_cov = np.diag(Cov).copy()
    diag_cov[diag_cov < 0] = 0.0
    unc = np.sqrt(diag_cov)
    return p_vec, unc, RSS, rms_fit, raw_rms

