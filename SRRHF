def get_sorted_params(vary_list, x_values, uncertainties=None):
    display_map = {'A':'A','B':'B','C':'C','DJ':'DeltaJ','DJK':'DeltaJK','DK':'DeltaK',
                   'dJ':'deltaJ','dK':'deltaK','d1':'d1','d2':'d2','Xbb_Xcc':'Xbb-Xcc'}
    data = {}; sorted_output = []
    if uncertainties is None: uncertainties = [0.0]*len(vary_list)
    for k, v, u in zip(vary_list, x_values, uncertainties): data[k] = (v, u)
    
    order = ['A','B','C','DJ','DJK','DK','dJ','dK','d1','d2','Xaa','Xbb_Xcc','Xab','Xac','Xbc']
    for k in order:
        if k in data: sorted_output.append((display_map.get(k,k), data[k][0], data[k][1]))
    return sorted_output

def write_pred_file(filename, vary_list, p_vals, unc, rss, rms_w, rms_raw):
    now = datetime.datetime.now()
    if abs(P.A - P.C) > 1e-9: kappa = (2*P.B - P.A - P.C) / (P.A - P.C)
    else: kappa = 0.0
    has_spin = (len(P.SPINS) > 0 and sum(P.SPINS) > 1e-5)
    
    with open(filename, 'w') as f:
        f.write(f"{now.strftime('%H:%M:%S')}          MONTH={now.month}  DAY={now.day}  {now.year}\n")
        f.write("Input data: \n")
        f.write("Rotational Constants\n")
        f.write(f"A = {Run.INIT_A}\n")
        f.write(f"B = {Run.INIT_B}\n")
        f.write(f"C = {Run.INIT_C}\n")
        f.write("DIPOLE MOMENTS\n")
        f.write(f"MUA  = {P.MUA}\n")
        f.write(f"MUB  = {P.MUB}\n")
        f.write(f"MUC  = {P.MUC}\n")
        f.write("--- SEMI-RIGID ROTOR HYPERFINE FIT ---\n")
        f.write(f"Input: {filename.replace('.pred','.txt')}\n")
        f.write(f"Molecule : {Run.NAME}\n")
        f.write(f"Hamiltonian: Watson {P.REDUCTION}-reduction ({P.REP} representation)\n")
        f.write(f"Loaded {len(Run.LINES)} transitions.\n")
        f.write(f"Frequency Range: {P.FMIN} - {P.FMAX} MHz\n")
        f.write(f"Ray's Asymmetry Parameter (Kappa): {kappa:.4f}\n\n")
        f.write(f"Fitting {len(vary_list)} params: {vary_list}\n\n")
        f.write("--- Fit Results ---\n")
        f.write(f"RMS (Weighted):   {rms_w:.6f} (Target: ~1.0)\n")
        f.write(f"RMS (Unweighted): {rms_raw:.6f} MHz\n\n")
        f.write(f"          {'Param':<23}{'Value':<18}Uncertainty\n")
        f.write("-" * 50 + "\n")
        for name, val, u in get_sorted_params(vary_list, p_vals, unc): 
            f.write(f" {name:>14}           {val:13.8f}              {u:10.8f}\n")
        f.write("\n--- Residuals (MHz) ---\n")
        
        hdr = "          J Ka Kc F      J Ka Kc F      Obs      Calc      Diff      Error" if has_spin else "          J Ka Kc      J Ka Kc      Obs      Calc      Diff      Error"
        f.write(f"{hdr}\n")
        for ln in Run.LINES:
            if has_spin and ln.F1 is not None:
                su = f"{ln.N1:2d} {ln.K1:1d}{ln.Kp1:2d}{ln.F1:4.1f}"
                sl = f"{ln.N2:2d} {ln.K2:1d}{ln.Kp2:2d}{ln.F2:4.1f}"
            else:
                su = f"{ln.N1:2d} {ln.K1:1d}{ln.Kp1:2d}    "
                sl = f"{ln.N2:2d} {ln.K2:1d}{ln.Kp2:2d}    "
                
            f.write(f"   {su}       {sl}         {ln.freq:10.4f}        {ln.calc:10.4f}        {ln.res:8.5f}        {ln.error:6.4f}\n")
            
        f.write("-" * 62 + "\n")
        f.write("Predictions (Center Frequencies)\n\n")
        levels = solve_energy_levels(P.JMAX)
        for J in range(1, P.JMAX + 1):
            groups = {'A': [], 'B': [], 'C': []}
            for J_lo in [J, J-1]:
                if J_lo < 0: continue
                ups = levels[J]; lows = levels[J_lo]
                for u in ups:
                    for l in lows:
                        dKa = abs(u['Ka'] - l['Ka']); dKc = abs(u['Kc'] - l['Kc'])
                        ttype = None
                        if (dKa % 2 == 0) and (dKc % 2 != 0): ttype = 'A'
                        elif (dKa % 2 != 0) and (dKc % 2 != 0): ttype = 'B'
                        elif (dKa % 2 != 0) and (dKc % 2 == 0): ttype = 'C'
                        if ttype:
                            freq = u['E'] - l['E']
                            if freq < 1e-6 or freq < P.FMIN or freq > P.FMAX: continue
                            line = f" {u['J']:2d}    {u['Ka']:1d}   {u['Kc']:2d}     {l['J']:2d}    {l['Ka']:1d}   {l['Kc']:2d}       {freq:10.3f}\n"
                            groups[ttype].append((freq, line))
            for ttype in ['A', 'B', 'C']:
                lines = groups[ttype]; lines.sort(key=lambda x: x[0])
                if lines:
                    f.write(f"     {ttype} type transitions for J = {J:2d}\n")
                    for _, txt in lines: f.write(txt)
                    f.write("\n")

def write_freq_file(filename):
    print("Generating Catalog...")
    levels = solve_energy_levels(P.JMAX)
    trans = []
    kT = P.kb_MHz * P.TEMP
    has_spin = (len(P.SPINS) > 0 and sum(P.SPINS) > 1e-5)
    I = P.SPINS[0] if has_spin else 0.0
    j_start = max(1, P.JMIN)
    for Ju in range(j_start, P.JMAX+1):
        for Jl in [Ju, Ju-1]:
            if Jl < 0: continue
            ups = levels[Ju]; lows = levels[Jl]
            for u in ups:
                for l in lows:
                    if abs(u['Ka']-l['Ka'])>1 or abs(u['Kc']-l['Kc'])>1: continue
                    if has_spin:
                        for u_hfs in u['hfs']:
                            for l_hfs in l['hfs']:
                                freq = u_hfs['E'] - l_hfs['E']
                                if freq < P.FMIN or freq > P.FMAX: continue
                                S = calc_matrix_intensity(u_hfs, l_hfs, Ju, Jl, I)
                                if S < 1e-9: continue
                                boltz = math.exp(-l_hfs['E']/kT) - math.exp(-u_hfs['E']/kT)
                                inten = freq * S * boltz
                                if inten <= 1e-30: continue
                                qu = f"{u['J']:2d} {u['Ka']:2d} {u['Kc']:2d} {u_hfs['F']:3.1f}"
                                ql = f"{l['J']:2d} {l['Ka']:2d} {l['Kc']:2d} {l_hfs['F']:3.1f}"
                                trans.append({'f': freq, 'i_abs': inten, 'qs': f"{qu}   {ql}"})
                    else:
                        freq = u['E'] - l['E']
                        if freq < P.FMIN or freq > P.FMAX: continue
                        u_hfs = u['hfs'][0]; l_hfs = l['hfs'][0]
                        S = calc_matrix_intensity(u_hfs, l_hfs, Ju, Jl, 0.0)
                        if S < 1e-9: continue
                        boltz = math.exp(-l['E']/kT) - math.exp(-u['E']/kT)
                        inten = freq * S * boltz
                        if inten <= 1e-30: continue
                        qu = f"{u['J']:2d} {u['Ka']:2d} {u['Kc']:2d}"
                        ql = f"{l['J']:2d} {l['Ka']:2d} {l['Kc']:2d}"
                        trans.append({'f': freq, 'i_abs': inten, 'qs': f"{qu}   {ql}"})

    if trans:
        max_i = max(t['i_abs'] for t in trans)
        for t in trans: t['i'] = math.log10(t['i_abs']/max_i + 1e-20)
    trans.sort(key=lambda x: x['f'])
    with open(filename, 'w') as f:
        now = datetime.datetime.now()
        f.write(f"{now.strftime('%H:%M:%S')}          MONTH={now.month}  DAY={now.day}  {now.year}\n")
        f.write(f"Frequency      LogInt    QNs (Up - Low)\n")
        f.write("-------------------------------------------------------\n")
        for t in trans: f.write(f"   {t['f']:9.4f}       {t['i']:7.4f}    {t['qs']}\n")

def main():
    in_file = "3top_input.txt"
    if len(sys.argv) > 1: in_file = sys.argv[1]
    parse_input(in_file)
    vary_list = [p for p, v, f in Run.VARY if f == 2]
    if vary_list and Run.LINES:
        p_vec, unc, rss, rms_w, rms_raw = run_fit(vary_list)
        write_pred_file(in_file.replace('.txt','.pred'), vary_list, p_vec, unc, rss, rms_w, rms_raw)
    else:
        write_pred_file(in_file.replace('.txt','.pred'), [], [], [], 0, 0, 0)
    write_freq_file(in_file.replace('.txt','.freq'))

if __name__ == "__main__":
    main()
